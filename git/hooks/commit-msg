#!/bin/sh
# Opens the agent's commit message for editing before the commit, through meatproxy-edit:
# a tmux popup over the attached client, or the next meatproxy input method when there is
# none. The staged file list sits under the message as comments and never reaches it.
# Off switch: touch ~/.local/state/commit-review-off (nvim <leader>tc toggles it).
flag="${XDG_STATE_HOME:-$HOME/.local/state}/commit-review-off"
wait_seconds="${COMMIT_REVIEW_WAIT:-100}"

if { [ "$CLAUDECODE" = "1" ] || [ "$HERMES_AGENT" = "true" ]; } && [ ! -e "$flag" ] && command -v meatproxy-edit >/dev/null 2>&1; then
	msg="$(realpath "$1")"
	top="$(git rev-parse --show-toplevel)"
	width=80
	if [ -n "$TMUX_PANE" ]; then
		session="$(tmux display-message -p -t "$TMUX_PANE" '#{session_id}')"
		client_width="$(tmux list-clients -t "$session" -F '#{client_width}' | head -n 1)"
		[ -n "$client_width" ] && width=$((client_width * 70 / 100 - 4))
	fi
	stat="$msg.stat"
	git diff --cached --stat="$width" --no-color >"$stat"

	echo "commit message is open for the user in a meatproxy window; waiting up to ${wait_seconds}s" >&2
	meatproxy-edit "$msg" --purpose "commit message for $(basename "$top")" --caller agent \
		--note-file "$stat" --file-name COMMIT_EDITMSG --wait "$wait_seconds" 2>/dev/null
	status=$?
	rm -f "$stat"

	case "$status" in
	0)
		if ! git stripspace --strip-comments <"$msg" | grep -q .; then
			echo "commit-msg: commit message was emptied by the user, commit aborted." >&2
			exit 1
		fi
		;;
	1)
		echo "commit-msg: commit message rejected by the user (editor closed with :cq or emptied). Ask the user what to change." >&2
		exit 1
		;;
	5) echo "commit-msg: user did not answer in ${wait_seconds}s, committing the message as written." >&2 ;;
	*) echo "commit-msg: no meatproxy window could be opened, committing the message as written." >&2 ;;
	esac
fi

# chain to repo-local hook so husky/commitlint still run
local_hook="$(git rev-parse --git-common-dir 2>/dev/null)/hooks/commit-msg"
if [ -n "$local_hook" ] && [ -x "$local_hook" ]; then
	exec "$local_hook" "$@"
fi
