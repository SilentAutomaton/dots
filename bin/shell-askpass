#!/usr/bin/env python3
# SUDO_ASKPASS that asks inside the Quickshell shell, as a card among the
# notifications, and keeps the whole command however long it is. The context,
# the danger check and the journal line come from claude-askpass itself; when
# the shell is not running, claude-askpass takes over and asks the old way.
#
# The shell gets only a socket path over IPC. The context goes out and the
# password comes back over that socket, in a directory only this user can open.

import importlib.machinery
import importlib.util
import json
import os
import socket
import subprocess
import sys
import tempfile

ASKPASS = "/usr/local/bin/claude-askpass"
SHELL_CONNECT_TIMEOUT_S = 10


def load_askpass():
    loader = importlib.machinery.SourceFileLoader("askpass", ASKPASS)
    spec = importlib.util.spec_from_loader("askpass", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def fall_back() -> None:
    os.execv(ASKPASS, [ASKPASS, *sys.argv[1:]])


def ask_shell(askpass, ctx: dict, prompt: str) -> dict | None:
    runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    with tempfile.TemporaryDirectory(dir=runtime, prefix="askpass-") as directory:
        path = os.path.join(directory, "socket")
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as server:
            server.bind(path)
            server.listen(1)
            called = subprocess.run(["qs", "-c", "shell", "ipc", "call", "askpass", "request", path],
                                    capture_output=True, timeout=5)
            if called.returncode != 0:
                return None
            server.settimeout(SHELL_CONNECT_TIMEOUT_S)
            try:
                connection, _ = server.accept()
            except TimeoutError:
                return None
        with connection:
            connection.settimeout(None)
            message = {**ctx, "prompt": prompt, "title": askpass.title(ctx),
                       "dangerous": askpass.is_dangerous(ctx.get("command", ""))}
            connection.sendall((json.dumps(message) + "\n").encode())
            reply = connection.makefile("r", encoding="utf-8").readline()
    return json.loads(reply) if reply else {"cancel": True}


def main() -> int:
    askpass = load_askpass()
    prompt = sys.argv[1] if len(sys.argv) > 1 else "[sudo] password: "
    ctx = askpass.context()
    if not askpass.graphical():
        fall_back()
    try:
        reply = ask_shell(askpass, ctx, prompt)
    except (OSError, subprocess.TimeoutExpired):
        reply = None
    if reply is None:
        fall_back()
    if "password" not in reply:
        askpass.log(ctx, "declined")
        return askpass.EXIT_DECLINED
    askpass.log(ctx, "ok")
    print(reply["password"])
    return askpass.EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
