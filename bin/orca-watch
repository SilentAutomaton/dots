#!/usr/bin/python3
# Watches OrcaSlicer's modal dialogs over AT-SPI and turns them into cards.
# The dialog stays where it is, out of the way; the shell shows its text and
# buttons, and a click on a card button presses the real button.

import gi

gi.require_version("Atspi", "2.0")
from gi.repository import Atspi, GLib

import itertools
import json
import os
import re
import socketserver
import subprocess
import sys
import threading
import time

APP_NAME = "orca-slicer"
RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
SHELL_SOCKET = f"{RUNTIME_DIR}/orca-alerts.sock"
# wxGTK shows its modal dialogs as plain frames; the project window is a frame
# too, but its title always ends in the app name, with a * prefix when focused
DIALOG_ROLES = {"frame", "dialog", "alert"}
MAIN_WINDOW_END = "orcaslicer"
NODE_LIMIT = 400


def is_main_window(node) -> bool:
    return clean(node.get_name() or "").lower().endswith(MAIN_WINDOW_END)


def is_dialog(node) -> bool:
    # file choosers need the real window to pick a file, so they stay out
    return node.get_role_name() in DIALOG_ROLES and not is_main_window(node)


def clean(text: str) -> str:
    return re.sub(r"\s+", " ", text.replace("&", "")).strip()


def app_of(node) -> str:
    try:
        return node.get_application().get_name()
    except Exception:
        return ""


def find_app():
    desktop = Atspi.get_desktop(0)
    for i in range(desktop.get_child_count()):
        app = desktop.get_child_at_index(i)
        if app.get_name() == APP_NAME:
            return app
    return None


# The order of DeviceErrorDialog::init_button_list in OrcaSlicer 2.4.2. The
# dialog holds a panel of every button and shows only the ones the error needs.
# Orca draws these buttons itself, so AT-SPI has no names for them; a button's
# place among the panel's children gives its label.
DEVICE_ERROR_BUTTONS = [
    "Resume Printing", "Resume (defects acceptable)", "Resume (problem solved)",
    "Stop Printing", "Check Assistant", "Filament Extruded, Continue",
    "Not Extruded Yet, Retry", "Finished, Continue", "Load Filament", "OK",
    "Filament Loaded, Resume", "View Liveview", "No Reminder Next Time",
    "Ignore. Don't Remind Next Time", "Ignore this and Resume",
    "Problem Solved and Resume", "Got it, Turn off the Fire Alarm.",
    "Retry (problem solved)", "Cancel", "Stop Drying", "Proceed", "Cancel",
    "Done", "Retry", "Resume", "Confirm",
]


def device_error_buttons(node) -> list:
    if node.get_child_count() != 2 + len(DEVICE_ERROR_BUTTONS):
        return []
    if node.get_child_at_index(1).get_role_name() != "scroll pane":
        return []
    buttons = []
    for i, label in enumerate(DEVICE_ERROR_BUTTONS, start=2):
        child = node.get_child_at_index(i)
        if child.get_state_set().contains(Atspi.StateType.SHOWING):
            buttons.append((label, child))
    return buttons


def describe(node) -> dict:
    texts, buttons = [], []
    stack = [(node, 0)]
    while stack and len(texts) + len(buttons) < NODE_LIMIT:
        current, depth = stack.pop()
        try:
            role, name = current.get_role_name(), clean(current.get_name() or "")
            if role == "push button" and name:
                buttons.append((name, current))
            elif role == "label" and name and name not in texts:
                texts.append(name)
            elif role == "panel":
                buttons.extend(device_error_buttons(current))
            if depth < 8:
                for i in reversed(range(current.get_child_count())):
                    stack.append((current.get_child_at_index(i), depth + 1))
        except Exception:
            continue
    return {"texts": texts, "buttons": buttons}


# A drawn button takes the keyboard focus and clicks on Return; the key goes
# straight to the dialog's window, so the dialog does not need to be focused.
def window_address(title: str) -> str:
    clients = json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True).stdout)
    for client in clients:
        if client.get("initialClass") == APP_NAME and client.get("title") == title:
            return client["address"]
    return ""


# The window rules park these dialogs on a hidden workspace; Show brings one
# to the workspace in front of the user.
def show(address: str) -> None:
    workspace = json.loads(subprocess.run(["hyprctl", "activeworkspace", "-j"], capture_output=True, text=True).stdout)["id"]
    subprocess.run(["hyprctl", "dispatch",
                    "hl.dsp.window.move({ workspace = '%s', window = 'address:%s' })" % (workspace, address)],
                   capture_output=True)


def send_key(keysym: str, address: str) -> None:
    subprocess.run(["hyprctl", "dispatch",
                    "hl.dsp.send_shortcut({ mods = '', key = '%s', window = 'address:%s' })" % (keysym, address)],
                   capture_output=True)


class Dialogs:
    def __init__(self) -> None:
        self.lock = threading.Lock()
        self.open: dict[int, dict] = {}
        self.ids = itertools.count(int(time.time() * 1000))
        self.clients: list["ShellClient"] = []

    def broadcast(self, message: dict) -> None:
        line = (json.dumps(message) + "\n").encode()
        with self.lock:
            clients = list(self.clients)
        for client in clients:
            client.send(line)

    # Called on every event and sweep; a dialog announces itself once its
    # content is in the tree, however late its children appear.
    def arrived(self, node) -> None:
        info = describe(node)
        if not info["buttons"] and not info["texts"]:
            return
        title = clean(node.get_name() or "") or "OrcaSlicer"
        dedup = (title, tuple(info["texts"]), tuple(name for name, _ in info["buttons"]))
        # the dialog fills in its buttons late and is reused for the next
        # error, so a changed dialog replaces its card
        with self.lock:
            if any(d["key"] == dedup for d in self.open.values()):
                return
            stale = [i for i, d in self.open.items() if d["node"] == node]
        for dialog_id in stale:
            self.drop(dialog_id)
        with self.lock:
            dialog = {"id": next(self.ids), "node": node, "key": dedup, "title": title,
                      "text": "\n".join(info["texts"]), "buttons": info["buttons"] + [("Show", None)]}
            self.open[dialog["id"]] = dialog
        self.broadcast({"type": "ask", "id": dialog["id"], "title": title,
                        "text": "\n".join(info["texts"]),
                        "buttons": [{"index": i, "label": name} for i, (name, _) in enumerate(dialog["buttons"])]})

    def answer(self, message: dict) -> None:
        with self.lock:
            dialog = self.open.get(int(message["id"]))
        if dialog is None:
            return
        _, button = dialog["buttons"][int(message["index"])]
        if button is not None and button.get_role_name() == "push button":
            try:
                button.do_action(0)
            except Exception as e:
                print("orca-watch: pressing the button failed:", e, file=sys.stderr)
            return
        address = window_address(dialog["title"])
        if not address:
            print("orca-watch: dialog window not found:", dialog["title"], file=sys.stderr)
            return
        if button is None:
            show(address)
            return
        button.grab_focus()
        send_key("Return", address)

    def drop(self, dialog_id: int) -> None:
        with self.lock:
            dialog = self.open.pop(dialog_id, None)
        if dialog is not None:
            self.broadcast({"type": "resolved", "id": dialog_id})

    # Objects of closed dialogs go stale; a dead node means the dialog is gone.
    # The scan catches dialogs whose add event never arrived.
    def sweep(self) -> bool:
        app = find_app()
        if app is not None:
            for i in range(app.get_child_count()):
                child = app.get_child_at_index(i)
                if is_dialog(child):
                    self.arrived(child)
        with self.lock:
            items = list(self.open.items())
        for dialog_id, dialog in items:
            try:
                alive = app_of(dialog["node"]) == APP_NAME and dialog["node"].get_state_set().contains(Atspi.StateType.SHOWING)
            except Exception:
                alive = False
            if not alive:
                self.drop(dialog_id)
        return True


class ShellClient(socketserver.StreamRequestHandler):
    dialogs: Dialogs

    def setup(self) -> None:
        super().setup()
        self.write_lock = threading.Lock()

    def send(self, line: bytes) -> None:
        try:
            with self.write_lock:
                self.wfile.write(line)
                self.wfile.flush()
        except OSError:
            pass

    def handle(self) -> None:
        with self.dialogs.lock:
            self.dialogs.clients.append(self)
            open_items = list(self.dialogs.open.items())
        # a shell that connects mid-dialog still sees what is open
        for dialog_id, d in open_items:
            self.send((json.dumps({"type": "ask", "id": dialog_id, "title": d["title"],
                                   "text": d["text"], "buttons": [
                                       {"index": i, "label": name} for i, (name, _) in enumerate(d["buttons"])]}) + "\n").encode())
        try:
            for line in self.rfile:
                message = json.loads(line)
                if message["type"] == "answer":
                    # AT-SPI is not thread safe; the press runs on the main loop
                    GLib.idle_add(self.dialogs.answer, message)
                elif message["type"] == "dismiss":
                    self.dialogs.drop(int(message["id"]))
        except (ConnectionResetError, json.JSONDecodeError):
            pass
        finally:
            with self.dialogs.lock:
                self.dialogs.clients.remove(self)


def serve_shell(dialogs: Dialogs) -> None:
    if os.path.exists(SHELL_SOCKET):
        os.unlink(SHELL_SOCKET)
    ShellClient.dialogs = dialogs
    server = socketserver.ThreadingUnixStreamServer(SHELL_SOCKET, ShellClient)
    os.chmod(SHELL_SOCKET, 0o600)
    threading.Thread(target=server.serve_forever, daemon=True).start()


def on_children_changed(event) -> None:
    try:
        # the added child rides in any_data; children appearing inside a known
        # dialog arrive with the dialog itself as the source
        candidates = [event.any_data, event.source]
        for node in candidates:
            if node is not None and is_dialog(node) and app_of(node) == APP_NAME:
                DIALOGS.arrived(node)
    except Exception:
        pass


def check() -> int:
    app = find_app()
    if app is None:
        print(f"orca-watch: {APP_NAME} is not in AT-SPI; is it running?", file=sys.stderr)
        return 1
    windows = []
    for i in range(app.get_child_count()):
        child = app.get_child_at_index(i)
        if child is not None:
            windows.append((child.get_role_name(), clean(child.get_name() or "")))
    print("ok:", windows)
    return 0


DIALOGS = Dialogs()

if __name__ == "__main__":
    if "--check" in sys.argv:
        sys.exit(check())
    serve_shell(DIALOGS)
    listener = Atspi.EventListener.new(on_children_changed)
    Atspi.EventListener.register(listener, "object:children-changed")
    GLib.timeout_add_seconds(2, DIALOGS.sweep)
    GLib.MainLoop().run()
