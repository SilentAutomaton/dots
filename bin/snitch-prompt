#!/usr/bin/python3
# Stands between opensnitchd and opensnitch-ui. Everything goes through to the
# GUI except AskRule: those prompts go to the Quickshell shell over a unix
# socket, as JSON lines, and come back as rules.
#
# The daemon waits at most 120 s for an answer and asks one question at a time,
# so a prompt is held for `hold` seconds and then denied once. The card stays,
# and a late answer becomes a rule pushed through the Notifications stream.

import importlib.util
import itertools
import ipaddress
import json
import os
import pwd
import queue
import re
import socketserver
import sys
import threading
import time
import types
from concurrent import futures
from dataclasses import dataclass, field

import grpc

PROTO_DIR = "/usr/lib/python{0}.{1}/site-packages/opensnitch/proto".format(*sys.version_info)
DAEMON_SOCKET = "/tmp/osui.sock"
RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
GUI_ADDRESS = f"unix://{RUNTIME_DIR}/opensnitch-gui.sock"
SHELL_SOCKET = f"{RUNTIME_DIR}/snitch-prompt.sock"
DAEMON_DEADLINE_S = 120
DEFAULT_HOLD_S = 115
DURATIONS = ("once", "30s", "5m", "15m", "30m", "1h", "12h", "until restart", "always")
ACTIONS = ("allow", "deny", "reject")


def load_proto() -> tuple[types.ModuleType, types.ModuleType]:
    # opensnitch.proto's own __init__ pulls in Qt; load the two generated files alone
    package = types.ModuleType("snitchproto")
    package.__path__ = [PROTO_DIR]
    sys.modules["snitchproto"] = package
    modules = []
    for name in ("ui_pb2", "ui_pb2_grpc"):
        spec = importlib.util.spec_from_file_location(f"snitchproto.{name}", f"{PROTO_DIR}/{name}.py")
        module = importlib.util.module_from_spec(spec)
        sys.modules[spec.name] = module
        spec.loader.exec_module(module)
        modules.append(module)
    return modules[0], modules[1]


ui_pb2, ui_pb2_grpc = load_proto()


def slugify(text: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")


def user_name(uid: int) -> str:
    try:
        return pwd.getpwuid(uid).pw_name
    except KeyError:
        return str(uid)


def target_options(con) -> list[dict]:
    """What a rule can match, in the order opensnitch-ui offers it."""
    options = []

    def add(key: str, label: str, kind: str, operand: str, data: str) -> None:
        options.append({"key": key, "label": label, "type": kind, "operand": operand, "data": data})

    args = " ".join(con.process_args)
    add("path", "from this executable", "simple", "process.path", con.process_path)
    if args:
        add("command", "from this command line", "simple", "process.command", args)
    if con.dst_port:
        add("port", f"to port {con.dst_port}", "simple", "dest.port", str(con.dst_port))
    add("ip", f"to {con.dst_ip}", "simple", "dest.ip", con.dst_ip)
    if con.dst_host and con.dst_host != con.dst_ip:
        add("host", f"to {con.dst_host}", "simple", "dest.host", con.dst_host)
        labels = con.dst_host.split(".")[1:]
        for i in range(len(labels) - 1):
            domain = ".".join(labels[i:])
            add(f"domain:{domain}", f"to *.{domain}", "regexp", "dest.host",
                r"^(|.*\.)%s$" % re.escape(domain))
    add("user", f"from user {user_name(con.user_id)}", "simple", "user.id", str(con.user_id))
    add("pid", f"from PID {con.process_id}", "simple", "process.id", str(con.process_id))
    address = ipaddress.ip_address(con.dst_ip)
    for prefix in (24, 16, 8) if address.version == 4 else (64,):
        network = ipaddress.ip_network(f"{con.dst_ip}/{prefix}", strict=False)
        add(f"net:{prefix}", f"to {network}", "network", "dest.network", str(network))
    return options


EXTRAS = {
    "dstIp": lambda con: ("dest.ip", con.dst_ip),
    "dstPort": lambda con: ("dest.port", str(con.dst_port)),
    "uid": lambda con: ("user.id", str(con.user_id)),
    "checksum": lambda con: ("process.hash.md5", con.process_checksums.get("process.hash.md5", "")),
}


def build_rule(con, action: str, duration: str, target: str, extras: list[str]):
    option = next(o for o in target_options(con) if o["key"] == target)
    rule = ui_pb2.Rule(created=int(time.time()), enabled=True, action=action, duration=duration)
    rule.operator.type, rule.operator.operand, rule.operator.data = option["type"], option["operand"], option["data"]
    conditions = [(operand, data) for operand, data in (EXTRAS[e](con) for e in extras)
                  if data and operand != option["operand"]]
    # A command line that does not start with an absolute path proves nothing
    # about the binary; pin the executable too, as opensnitch-ui does.
    first_arg = con.process_args[0] if con.process_args else ""
    if option["operand"] == "process.command" and (not first_arg.startswith("/") or first_arg.startswith("/proc")):
        conditions.append(("process.path", con.process_path))
    kind = "list" if conditions else "simple"
    rule.name = slugify(f"{action} {duration} {kind} {option['data']}")[:128]
    if conditions:
        operators = [{"type": "simple", "operand": o, "data": d} for o, d in conditions]
        operators.append({"type": option["type"], "operand": option["operand"], "data": option["data"]})
        rule.operator.type = rule.operator.operand = "list"
        rule.operator.data = json.dumps(operators)
        rule.operator.list.extend(ui_pb2.Operator(sensitive=False, **o) for o in operators)
    return rule


def deny_once(con):
    rule = ui_pb2.Rule(name="snitch-prompt-deny-once", created=int(time.time()), enabled=True,
                       action="deny", duration="once")
    rule.operator.type, rule.operator.operand, rule.operator.data = "simple", "process.path", con.process_path
    return rule


def describe(prompt_id: int, con, created: int) -> dict:
    env = dict(con.process_env)
    return {
        "type": "ask",
        "id": prompt_id,
        "protocol": con.protocol,
        "srcIp": con.src_ip,
        "srcPort": con.src_port,
        "dstIp": con.dst_ip,
        "dstHost": con.dst_host,
        "dstPort": con.dst_port,
        "uid": con.user_id,
        "user": user_name(con.user_id),
        "pid": con.process_id,
        "path": con.process_path,
        "cwd": con.process_cwd,
        "args": list(con.process_args),
        "md5": con.process_checksums.get("process.hash.md5", ""),
        "tree": [{"path": p.key, "pid": p.value} for p in con.process_tree],
        # only the Steam ids: the rest of the environment can hold secrets
        "steamAppId": env.get("SteamAppId") or env.get("SteamGameId", ""),
        "targets": [{"key": o["key"], "label": o["label"]} for o in target_options(con)],
        "created": created,
    }




@dataclass
class Prompt:
    id: int
    con: object
    key: tuple
    created: int = field(default_factory=lambda: int(time.time()))
    held: bool = False
    answered: threading.Event = field(default_factory=threading.Event)
    rule: object = None

    def describe(self) -> dict:
        return describe(self.id, self.con, self.created)


class ShellClient(socketserver.StreamRequestHandler):
    prompts: "Prompts"

    def setup(self) -> None:
        super().setup()
        self.write_lock = threading.Lock()

    def send(self, line: bytes) -> None:
        try:
            with self.write_lock:
                self.wfile.write(line)
                self.wfile.flush()
        except OSError:
            pass

    def handle(self) -> None:
        for message in self.prompts.backlog():
            self.send((json.dumps(message) + "\n").encode())
        with self.prompts.lock:
            self.prompts.clients.append(self)
        try:
            for line in self.rfile:
                self.dispatch(json.loads(line))
        except ConnectionResetError:
            pass  # the shell reloads by dropping the socket
        finally:
            with self.prompts.lock:
                self.prompts.clients.remove(self)

    def dispatch(self, message: dict) -> None:
        if message["type"] == "answer":
            self.prompts.answer(message)
        elif message["type"] == "dismiss":
            self.prompts.dismiss(int(message["id"]))
        elif message["type"] == "config":
            self.prompts.hold = int(message["hold"])


class Prompts:
    def __init__(self, push_rule) -> None:
        self.lock = threading.Lock()
        self.pending: dict[int, Prompt] = {}
        self.ids = itertools.count(1)
        self.hold = DEFAULT_HOLD_S
        self.clients: list[ShellClient] = []
        self.push_rule = push_rule

    def broadcast(self, message: dict) -> None:
        line = (json.dumps(message) + "\n").encode()
        with self.lock:
            clients = list(self.clients)
        for client in clients:
            client.send(line)

    def ask(self, con):
        key = (con.process_path, con.dst_host or con.dst_ip, con.dst_port, con.protocol)
        with self.lock:
            if any(p.key == key for p in self.pending.values()):
                return deny_once(con)
            prompt = Prompt(next(self.ids), con, key)
            self.pending[prompt.id] = prompt
            hold = min(self.hold, DAEMON_DEADLINE_S - 5) if self.clients else 0
            prompt.held = hold > 0
        self.broadcast(prompt.describe())
        prompt.answered.wait(hold)
        with self.lock:
            prompt.held = False
            return prompt.rule or deny_once(con)

    def answer(self, message: dict) -> None:
        with self.lock:
            prompt = self.pending.pop(int(message["id"]), None)
            if prompt is None:
                return
            rule = build_rule(prompt.con, message["action"], message["duration"],
                              message["target"], message.get("extras", []))
            late = not prompt.held
            if not late:
                prompt.rule = rule
                prompt.answered.set()
        # "once" only means something while the connection is still waiting
        if late and rule.duration != "once":
            self.push_rule(rule)
        self.broadcast({"type": "resolved", "id": prompt.id})

    def dismiss(self, prompt_id: int) -> None:
        with self.lock:
            prompt = self.pending.pop(prompt_id, None)
            if prompt is not None:
                prompt.answered.set()
        if prompt is not None:
            self.broadcast({"type": "resolved", "id": prompt_id})

    def backlog(self) -> list[dict]:
        with self.lock:
            return [p.describe() for p in self.pending.values()]


class Proxy(ui_pb2_grpc.UIServicer):
    def __init__(self) -> None:
        self.gui = ui_pb2_grpc.UIStub(grpc.insecure_channel(GUI_ADDRESS))
        self.prompts = Prompts(self.push_rule)
        self.subscription = None
        self.to_daemon: queue.Queue | None = None
        self.own_ids: set[int] = set()
        self.own_id = itertools.count(1)

    def gui_call(self, method, request, fallback):
        try:
            return method(request, timeout=5)
        except grpc.RpcError:
            return fallback

    def Ping(self, request, context):
        return self.gui_call(self.gui.Ping, request, ui_pb2.PingReply(id=request.id))

    def Subscribe(self, request, context):
        self.subscription = request
        return self.gui_call(self.gui.Subscribe, request, request)

    def PostAlert(self, request, context):
        return self.gui_call(self.gui.PostAlert, request, ui_pb2.MsgResponse(id=request.id))

    def AskRule(self, request, context):
        return self.prompts.ask(request)

    def push_rule(self, rule) -> None:
        if self.to_daemon is None:
            print("snitch-prompt: daemon stream closed, rule lost:", rule.name, file=sys.stderr)
            return
        # GUI ids are timestamps around 1e16; ours are small and never collide
        notification = ui_pb2.Notification(id=next(self.own_id), type=ui_pb2.CHANGE_RULE, rules=[rule])
        self.own_ids.add(notification.id)
        self.to_daemon.put(notification)

    def Notifications(self, request_iterator, context):
        to_daemon: queue.Queue = queue.Queue()
        to_gui: queue.Queue = queue.Queue()
        self.to_daemon = to_daemon
        threading.Thread(target=self.relay_replies, args=(request_iterator, to_gui), daemon=True).start()
        threading.Thread(target=self.relay_gui, args=(context, to_daemon, to_gui), daemon=True).start()
        while context.is_active():
            try:
                yield to_daemon.get(timeout=1)
            except queue.Empty:
                continue

    def relay_replies(self, replies, to_gui: queue.Queue) -> None:
        try:
            for reply in replies:
                if reply.id in self.own_ids:
                    self.own_ids.discard(reply.id)
                    if reply.code == ui_pb2.ERROR:
                        print("snitch-prompt: daemon refused a rule:", reply.data, file=sys.stderr)
                else:
                    to_gui.put(reply)
        except grpc.RpcError:
            pass
        to_gui.put(None)

    def relay_gui(self, context, to_daemon: queue.Queue, to_gui: queue.Queue) -> None:
        # opensnitch-ui may start later or restart; a new stream needs a fresh
        # Subscribe first, or the GUI does not know which node is talking
        while context.is_active():
            try:
                if self.subscription is not None:
                    self.gui.Subscribe(self.subscription, timeout=5)
                for notification in self.gui.Notifications(iter(to_gui.get, None)):
                    to_daemon.put(notification)
            except grpc.RpcError:
                pass
            time.sleep(2)


def serve_shell(prompts: Prompts) -> None:
    if os.path.exists(SHELL_SOCKET):
        os.unlink(SHELL_SOCKET)
    ShellClient.prompts = prompts
    server = socketserver.ThreadingUnixStreamServer(SHELL_SOCKET, ShellClient)
    os.chmod(SHELL_SOCKET, 0o600)
    server.daemon_threads = True
    threading.Thread(target=server.serve_forever, daemon=True).start()


def main() -> None:
    proxy = Proxy()
    serve_shell(proxy.prompts)
    if os.path.exists(DAEMON_SOCKET):
        os.unlink(DAEMON_SOCKET)
    server = grpc.server(futures.ThreadPoolExecutor(max_workers=16),
                         options=[("grpc.max_receive_message_length", 4 * 1024 * 1024)])
    ui_pb2_grpc.add_UIServicer_to_server(proxy, server)
    server.add_insecure_port(f"unix://{DAEMON_SOCKET}")
    server.start()
    server.wait_for_termination()


def check() -> None:
    con = ui_pb2.Connection(protocol="tcp", dst_ip="93.184.216.34", dst_host="www.example.com", dst_port=443,
                            user_id=1000, process_id=42, process_path="/usr/bin/curl",
                            process_args=["curl", "https://www.example.com"],
                            process_checksums={"process.hash.md5": "abc"})
    keys = [o["key"] for o in target_options(con)]
    assert keys[:5] == ["path", "command", "port", "ip", "host"], keys
    assert "domain:example.com" in keys and "net:24" in keys

    rule = build_rule(con, "allow", "always", "path", [])
    assert (rule.operator.type, rule.operator.operand, rule.operator.data) == ("simple", "process.path", "/usr/bin/curl")
    assert rule.name == "allow-always-simple-usr-bin-curl"

    rule = build_rule(con, "deny", "1h", "command", [])
    assert rule.operator.type == "list", "relative argv[0] pins the executable"
    assert {o.operand for o in rule.operator.list} == {"process.command", "process.path"}

    rule = build_rule(con, "allow", "always", "domain:example.com", ["dstPort", "checksum"])
    assert re.match(rule.operator.list[-1].data, "api.example.com")
    assert [o.operand for o in rule.operator.list] == ["dest.port", "process.hash.md5", "dest.host"]

    pushed = []
    prompts = Prompts(pushed.append)
    assert prompts.ask(con).action == "deny", "no shell listening: deny at once"
    prompt_id = next(iter(prompts.pending))
    assert prompts.ask(con).name == "snitch-prompt-deny-once" and len(prompts.pending) == 1
    prompts.answer({"id": prompt_id, "action": "allow", "duration": "always", "target": "host"})
    assert pushed and pushed[0].operator.data == "www.example.com" and not prompts.pending

    sent = []
    prompts.clients.append(types.SimpleNamespace(send=sent.append))
    answer = threading.Timer(0.2, lambda: prompts.answer(
        {"id": json.loads(sent[0])["id"], "action": "allow", "duration": "once", "target": "path"}))
    answer.start()
    rule = prompts.ask(con)
    assert (rule.action, rule.duration) == ("allow", "once"), "an answer inside the hold goes to the daemon"
    assert len(pushed) == 1
    print("ok")


if __name__ == "__main__":
    check() if "--check" in sys.argv else main()
