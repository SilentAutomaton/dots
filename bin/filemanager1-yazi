#!/usr/bin/env python3
# Answers org.freedesktop.FileManager1, the D-Bus call behind "Show in folder"
# in browsers and chat apps, by opening yazi in kitty. Exits after a minute idle.
import subprocess
import sys

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

IDLE_SECONDS = 60

XML = """
<node>
  <interface name="org.freedesktop.FileManager1">
    <method name="ShowFolders"><arg type="as" direction="in"/><arg type="s" direction="in"/></method>
    <method name="ShowItems"><arg type="as" direction="in"/><arg type="s" direction="in"/></method>
    <method name="ShowItemProperties"><arg type="as" direction="in"/><arg type="s" direction="in"/></method>
  </interface>
</node>
"""

loop = GLib.MainLoop()
idle = {"source": None}


def restart_idle_timer():
    if idle["source"]:
        GLib.source_remove(idle["source"])
    idle["source"] = GLib.timeout_add_seconds(IDLE_SECONDS, loop.quit)


def open_in_yazi(uri):
    path = Gio.File.new_for_uri(uri).get_path()
    if path:
        subprocess.Popen(
            ["kitty", "-1", "--class", "yazi", "-e", "yazi", path],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )


def on_call(connection, sender, path, interface, method, params, invocation):
    # yazi opened on a file reveals it, on a folder lists it
    for uri in params.unpack()[0]:
        open_in_yazi(uri)
    invocation.return_value(None)
    restart_idle_timer()


def on_bus(connection, name):
    node = Gio.DBusNodeInfo.new_for_xml(XML)
    connection.register_object(
        "/org/freedesktop/FileManager1", node.interfaces[0], on_call, None, None
    )


def on_lost(connection, name):
    sys.exit(f"cannot own {name}: another file manager holds it")


Gio.bus_own_name(
    Gio.BusType.SESSION,
    "org.freedesktop.FileManager1",
    Gio.BusNameOwnerFlags.DO_NOT_QUEUE,
    on_bus,
    None,
    on_lost,
)
restart_idle_timer()
loop.run()
