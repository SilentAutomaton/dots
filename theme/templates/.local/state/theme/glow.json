{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#${on_background}", "margin": 2 },
  "block_quote": { "indent": 1, "indent_token": "│ ", "color": "#${on_surface_variant}", "italic": true },
  "paragraph": {},
  "list": { "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#${primary}", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#${on_primary}", "background_color": "#${primary}", "bold": true },
  "h2": { "prefix": "## " },
  "h3": { "prefix": "### ", "color": "#${secondary}" },
  "h4": { "prefix": "#### ", "color": "#${secondary}" },
  "h5": { "prefix": "##### ", "color": "#${tertiary}" },
  "h6": { "prefix": "###### ", "color": "#${tertiary}", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "italic": true },
  "strong": { "bold": true },
  "hr": { "color": "#${outline_variant}", "format": "\n────────\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#${primary}", "underline": true },
  "link_text": { "color": "#${secondary}", "bold": true },
  "image": { "color": "#${tertiary}", "underline": true },
  "image_text": { "color": "#${on_surface_variant}", "format": "Image: {{.text}} →" },
  "code": { "prefix": " ", "suffix": " ", "color": "#${term3}", "background_color": "#${surface_container}" },
  "code_block": {
    "color": "#${on_surface}",
    "margin": 2,
    "chroma": {
      "text": { "color": "#${on_surface}" },
      "error": { "color": "#${on_error}", "background_color": "#${error}" },
      "comment": { "color": "#${term8}" },
      "comment_preproc": { "color": "#${term3}" },
      "keyword": { "color": "#${tertiary}" },
      "keyword_reserved": { "color": "#${tertiary}" },
      "keyword_namespace": { "color": "#${tertiary}" },
      "keyword_type": { "color": "#${term3}" },
      "operator": { "color": "#${secondary}" },
      "punctuation": { "color": "#${on_surface_variant}" },
      "name": { "color": "#${on_surface}" },
      "name_builtin": { "color": "#${secondary}" },
      "name_tag": { "color": "#${tertiary}" },
      "name_attribute": { "color": "#${primary}" },
      "name_class": { "color": "#${term3}", "bold": true },
      "name_constant": { "color": "#${term1}" },
      "name_decorator": { "color": "#${term3}" },
      "name_function": { "color": "#${primary}" },
      "literal_number": { "color": "#${term1}" },
      "literal_string": { "color": "#${term2}" },
      "literal_string_escape": { "color": "#${secondary}" },
      "generic_deleted": { "color": "#${term1}" },
      "generic_emph": { "italic": true },
      "generic_inserted": { "color": "#${term2}" },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "#${outline}" },
      "background": { "background_color": "#${surface_container_low}" }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
