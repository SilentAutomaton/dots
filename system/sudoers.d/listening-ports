# The ports card in the right sidebar: owners of root sockets need root. Exactly these arguments, so no -K.
# It polls every 10 seconds, so sudo neither logs the call nor opens a PAM session for it.
Cmnd_Alias LISTENING_PORTS = /usr/bin/ss -tulpnH
Defaults!LISTENING_PORTS !log_allowed, !pam_session
%wheel ALL=(root) NOPASSWD: LISTENING_PORTS
