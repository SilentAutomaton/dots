# AUR security wrapper.
# `paru -S PKG` — pre-checks known packages before running paru.
# `paru TERM`  — skips pre-check (can't know selection yet);
#                ~/.config/paru/paru.conf FileManager checks each selected package post-selection.
function paru() {
    local -a args=("$@")
    local first="${args[0]:-}"

    # Pass through non-install operations directly
    case "$first" in
        -Q*|--query|-R*|--remove|-D*|--database|-F*|--files|-h|--help|-V|--version|\
        -Ss*|-Si*|-Sl*|-Sc*|-Scc*|-Syu*|-Syuu*)
            command paru "${args[@]}"
            return
            ;;
    esac

    # Only pre-check when -S is explicit (packages are known upfront)
    # Bare `paru TERM` skips this: FileManager handles post-selection per-package check
    local has_s_flag=false
    for a in "${args[@]}"; do
        [[ "$a" == -S || "$a" == -S[^sScQuyi]* ]] && has_s_flag=true
    done

    if $has_s_flag && [[ -z "${PARANOID_BYPASS:-}" ]]; then
        local pkgs=()
        for a in "${args[@]}"; do
            [[ "$a" != -* ]] && pkgs+=("$a")
        done
        if [[ ${#pkgs[@]} -gt 0 ]]; then
            echo "paranoid: pre-checking: ${pkgs[*]}"
            if ! python3 $HOME/proj/code/questions/aur_check/aur_check.py "${pkgs[@]}"; then
                echo ""
                echo "══ paranoid: BLOCKED ══════════════════════════════"
                echo "   bypass: PARANOID_BYPASS=1 paru ${args[*]}"
                echo "══════════════════════════════════════════════════"
                return 1
            fi
        fi
    fi

    command paru "${args[@]}"
}
